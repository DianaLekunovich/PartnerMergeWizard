<?xml version="1.0" encoding="utf-8"?>
<templates>
   <t t-name="button_contacts.ListView.Buttons" t-inherit="web.ListView.Buttons">
       <xpath expr="//div[hasclass('o_list_buttons')]" position="after">
           <button type="button" class="btn btn-primary" style="margin-left: 0px;"  t-on-click="showMergeModal" t-att-class="{'d-none': !state.showMergeButton}">
               Merge
           </button>
           <button type="button" class="btn btn-primary" style="margin-left: 0px;" t-on-click="findSimilarContacts" t-att-class="{'d-none': !state.showFindSimilarButton}">
                Find Similar
            </button>
       </xpath>
   </t>
</templates>
